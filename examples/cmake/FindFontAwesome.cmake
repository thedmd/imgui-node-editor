include(FetchContent)

# Font Awesome Free 7.3.1's font of each component, solid or regular (SIL Open Font License 1.1),
# embedded in a header of its own, FontAwesome_<component>.generated.h, and the names of the icons,
# IconsFontAwesome7.h of IconFontCppHeaders. Only these files are downloaded.
set(_FontAwesome_Revision     14c65a3747d0f3b751f15831fc719236aea8729d) # 7.3.1
set(_FontAwesome_solid_File   "Font Awesome 7 Free-Solid-900.otf")
set(_FontAwesome_solid_Hash   6beb23abfcf4d938c01fc7a109c636f0a84f9032ea698990a57d2fd30b010a26)
set(_FontAwesome_regular_File "Font Awesome 7 Free-Regular-400.otf")
set(_FontAwesome_regular_Hash 6ea0b33b149ce7e38573067b5d55ceccd49b245b38c053bcfde563e7ed343246)
set(_FontAwesome_GeneratedDir "${CMAKE_BINARY_DIR}/generated/FontAwesome")

if (NOT TARGET FontAwesome)
    FetchContent_Declare(
        IconFontCppHeaders
        URL                 https://raw.githubusercontent.com/juliettef/IconFontCppHeaders/210b5a399a64270674560d633638952d1e8d804d/IconsFontAwesome7.h
        URL_HASH            SHA256=34294d28e850b1580dbecdb2e6d42b68fe3a2e6ad0ac6135fd9c4f5a456b9461
        DOWNLOAD_NO_EXTRACT TRUE
    )

    FetchContent_MakeAvailable(IconFontCppHeaders)

    add_library(FontAwesome INTERFACE)

    target_include_directories(FontAwesome INTERFACE
        ${iconfontcppheaders_SOURCE_DIR}
        ${_FontAwesome_GeneratedDir}
    )
endif()

FetchContent_GetProperties(IconFontCppHeaders)

foreach(component ${FontAwesome_FIND_COMPONENTS})

    if (NOT DEFINED _FontAwesome_${component}_File)
        set(FontAwesome_${component}_FOUND FALSE)
        continue()
    endif()

    string(REPLACE " " "%20" _FontAwesome_Url "${_FontAwesome_${component}_File}")

    FetchContent_Declare(
        FontAwesome_${component}
        URL                 https://raw.githubusercontent.com/FortAwesome/Font-Awesome/${_FontAwesome_Revision}/otfs/${_FontAwesome_Url}
        URL_HASH            SHA256=${_FontAwesome_${component}_Hash}
        DOWNLOAD_NO_EXTRACT TRUE
        DOWNLOAD_NAME       FontAwesome_${component}.otf
    )

    FetchContent_MakeAvailable(FontAwesome_${component})

    # Converting the font takes CMake half a second, so the header is written again only for a
    # newer font.
    set(_FontAwesome_Font   "${fontawesome_${component}_SOURCE_DIR}/FontAwesome_${component}.otf")
    set(_FontAwesome_Header "${_FontAwesome_GeneratedDir}/FontAwesome_${component}.generated.h")
    if (NOT EXISTS "${_FontAwesome_Header}" OR "${_FontAwesome_Font}" IS_NEWER_THAN "${_FontAwesome_Header}")
        file(READ "${_FontAwesome_Font}" _FontAwesome_Bytes HEX)
        string(LENGTH "${_FontAwesome_Bytes}" _FontAwesome_Size)
        math(EXPR _FontAwesome_Size "${_FontAwesome_Size} / 2")
        string(REPEAT "[0-9a-f]" 64 _FontAwesome_Line)
        string(REGEX REPLACE "(${_FontAwesome_Line})" "\\1\n    " _FontAwesome_Bytes "${_FontAwesome_Bytes}")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _FontAwesome_Bytes "${_FontAwesome_Bytes}")
        file(WRITE "${_FontAwesome_Header}"
            "// Generated by FindFontAwesome.cmake from Font Awesome Free's \"${_FontAwesome_${component}_File}\",\n"
            "// under the SIL Open Font License 1.1.\n"
            "#pragma once\n"
            "\n"
            "namespace FontAwesome {\n"
            "\n"
            "static const unsigned char c_${component}FontData[] = {\n"
            "    ${_FontAwesome_Bytes}\n"
            "};\n"
            "\n"
            "static const unsigned int c_${component}FontSize = ${_FontAwesome_Size};\n"
            "\n"
            "} // namespace FontAwesome\n"
        )
    endif()

    set(FontAwesome_${component}_FOUND TRUE)

endforeach()

include(FindPackageHandleStandardArgs)

find_package_handle_standard_args(
    FontAwesome
    REQUIRED_VARS iconfontcppheaders_SOURCE_DIR
    HANDLE_COMPONENTS
)
